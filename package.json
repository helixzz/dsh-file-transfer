{
  "name": "dsh-file-transfer",
  "version": "0.2.0",
  "description": "Download and upload files from the DSH Web sidebar: streaming download/upload routes plus sidebar action buttons that work over a remote (reverse-proxied) connection.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "README.md",
    "README.zh.md",
    "README.ja.md",
    "README.ko.md",
    "README.es.md",
    "README.ru.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "download",
    "upload",
    "file-transfer",
    "sidebar"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
